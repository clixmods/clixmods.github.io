{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Content preview",
          "name": "preview",
          "type": "image"
        },
        {
          "title": "Is in draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "subtitle",
          "name": "subtitle",
          "type": "string"
        },
        {
          "title": "category",
          "name": "category",
          "type": "categories"
        },
        {
          "title": "fmContentType",
          "name": "fmContentType",
          "type": "string"
        },
        {
          "title": "image",
          "name": "image",
          "type": "image"
        }
      ]
    },
    {
      "name": "project-content-type",
      "pageBundle": false,
      "fields": [
        {
          "title": "Date de publication",
          "name": "date",
          "type": "datetime"
        },
        {
          "title": "Brouillon",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Titre du projet",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Sous-titre",
          "name": "subtitle",
          "type": "string"
        },
        {
          "title": "Description du projet",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Image principale",
          "name": "image",
          "type": "image"
        },
        {
          "title": "Logo du projet",
          "name": "logo",
          "type": "image"
        },
        {
          "title": "Étiquettes",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Langages de programmation",
          "name": "programming_languages",
          "type": "dataFile",
          "dataFileId": "programming_languages_simple",
          "dataFileKey": "name",
          "dataFileValue": "name",
          "multiple": true,
          "description": "Sélectionnez les langages de programmation utilisés dans ce projet"
        },
        {
          "title": "Frameworks & Moteurs",
          "name": "frameworks_engines",
          "type": "dataFile",
          "dataFileId": "frameworks_engines_simple",
          "dataFileKey": "name",
          "dataFileValue": "name",
          "multiple": true,
          "description": "Sélectionnez les frameworks et moteurs utilisés"
        },
        {
          "title": "Spécialités",
          "name": "specialties",
          "type": "dataFile",
          "dataFileId": "specialties",
          "dataFileKey": "name",
          "dataFileValue": "name",
          "multiple": true,
          "description": "Sélectionnez les spécialités impliquées dans ce projet"
        },
        {
          "title": "Soft Skills",
          "name": "soft_skills",
          "type": "dataFile",
          "dataFileId": "soft_skills",
          "dataFileKey": "name",
          "dataFileValue": "name",
          "multiple": true,
          "description": "Sélectionnez les soft skills nécessaires pour ce projet"
        },
        {
          "title": "Outils",
          "name": "tools",
          "type": "dataFile",
          "dataFileId": "tools",
          "dataFileKey": "name",
          "dataFileValue": "name",
          "multiple": true,
          "description": "Sélectionnez les outils utilisés dans ce projet"
        },
        {
          "title": "Catégorie",
          "name": "category",
          "type": "categories"
        },
        {
          "title": "Secteur d'activité",
          "name": "sector",
          "type": "choice",
          "choices": [
            "games-professionnel",
            "games-personnel",
            "games-gamejams",
            "appsweb-professionnel",
            "appsweb-etude",
            "mods",
            "tools"
          ],
          "description": "Valeurs combinées (ex: games-professionnel). Pas de champ subsector séparé."
        },
        {
          "title": "Projet à la une",
          "name": "featured",
          "type": "boolean"
        },
        {
          "title": "Statut",
          "name": "status",
          "type": "choice",
          "choices": [
            "Prochainement",
            "En Cours",
            "Terminé"
          ]
        },
        {
          "title": "Actions associées",
          "name": "actions",
          "type": "block",
          "fieldGroup": [
            "actions_group"
          ]
        },
        {
          "title": "Faits marquants",
          "name": "notable_facts",
          "type": "block",
          "fieldGroup": [
            "notable_facts_group"
          ]
        },
        {
          "title": "fmContentType",
          "name": "fmContentType",
          "type": "string"
        },
        {
          "title": "Contributeurs",
          "name": "contributors",
          "type": "block",
          "fieldGroup": [
            "contributors_group"
          ]
        },
        {
          "title": "Temps de développement",
          "name": "development_time",
          "type": "fields",
          "fields": [
            {
              "title": "total",
              "name": "total",
              "type": "string"
            },
            {
              "title": "start_date",
              "name": "start_date",
              "type": "datetime"
            },
            {
              "title": "end_date",
              "name": "end_date",
              "type": "datetime"
            },
            {
              "title": "phases",
              "name": "phases",
              "type": "block",
              "fieldGroup": [
                "phases_group"
              ]
            }
          ]
        },
        {
          "title": "Galleries d'images",
          "name": "galleries",
          "type": "block",
          "fieldGroup": [
            "galleries_group"
          ]
        },
        {
          "title": "Playlists Youtube",
          "name": "youtube_galleries",
          "type": "block",
          "fieldGroup": [
            "youtube_galleries_group"
          ]
        },
        {
          "title": "Vidéo Youtube",
          "name": "youtube_singles",
          "type": "block",
          "fieldGroup": [
            "youtube_singles_group"
          ]
        },
        {
          "title": "Spécifications techniques",
          "name": "technical_specs",
          "type": "block",
          "fieldGroup": [
            "technical_specs_group"
          ]
        },
        {
          "title": "Récompenses",
          "name": "awards",
          "type": "block",
          "fieldGroup": [
            "awards_group"
          ]
        },
        {
          "title": "Témoignages",
          "name": "testimonials",
          "type": "block",
          "fieldGroup": [
            "testimonials_group"
          ]
        }
      ]
    },
