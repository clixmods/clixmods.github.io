  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.pageFolders": [
    {
      "title": "posts",
      "path": "[[workspace]]/content/posts"
    },
    {
      "title": "projects",
      "path": "[[workspace]]/content/projects"
    },
    {
      "title": "people",
      "path": "[[workspace]]/content/people"
    },
    {
      "title": "experiences",
      "path": "[[workspace]]/content/experiences"
    },
    {
      "title": "educations",
      "path": "[[workspace]]/content/educations"
    }
  ],
  "frontMatter.content.draftField": {
    "name": "draft",
    "type": "boolean"
  },
  "frontMatter.data.files": [
    {
      "id": "profile",
      "title": "Profile Data",
      "file": "data/profile.json",
      "schema": {
        "title": "Profile",
        "type": "object",
        "properties": {
          "personal": {
            "type": "object",
            "title": "Informations personnelles",
            "properties": {
              "firstName": {
                "type": "string",
                "title": "Prénom"
              },
              "lastName": {
                "type": "string",
                "title": "Nom"
              },
              "fullName": {
                "type": "string",
                "title": "Nom complet"
              },
              "greeting": {
                "type": "string",
                "title": "Message d'accueil"
              },
              "title": {
                "type": "string",
                "title": "Titre professionnel"
              },
              "subtitle": {
                "type": "string",
                "title": "Sous-titre"
              },
              "bio": {
                "type": "string",
                "title": "Biographie",
                "widget": "textarea"
              }
            }
          },
          "media": {
            "type": "object",
            "title": "Médias",
            "properties": {
              "profileImage": {
                "type": "string",
                "title": "Image de profil"
              },
              "resumeFile": {
                "type": "string",
                "title": "Fichier CV"
              },
              "resumeFilename": {
                "type": "string",
                "title": "Nom du fichier CV"
              }
            }
          },
          "contact": {
            "type": "object",
            "title": "Contact",
            "properties": {
              "email": {
                "type": "string",
                "title": "Email"
              },
              "phone": {
                "type": "string",
                "title": "Téléphone"
              },
              "linkedin": {
                "type": "string",
                "title": "LinkedIn"
              },
              "github": {
                "type": "string",
                "title": "GitHub"
              },
              "location": {
                "type": "string",
                "title": "Localisation"
              },
              "status": {
                "type": "string",
                "title": "Statut"
              }
            }
          },
          "details": {
            "type": "object",
            "title": "Détails",
            "properties": {
              "formation": {
                "type": "string",
                "title": "Formation"
              },
              "speciality": {
                "type": "string",
                "title": "Spécialité"
              },
              "experience": {
                "type": "string",
                "title": "Expérience"
              }
            }
          }
        }
      }
    },
    {
      "id": "testimonials",
      "title": "Testimonials",
      "file": "data/testimonials.json",
      "labelField": "personId",
      "schema": {
        "title": "Testimonials",
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "title": "ID de la personne"
          },
          "position": {
            "type": "string",
            "title": "Poste / Rang"
          },
          "company": {
            "type": "string",
            "title": "Entreprise / Organisation"
          },
          "text": {
            "type": "string",
            "title": "Message de recommandation",
            "widget": "textarea"
          }
        },
        "required": [
          "personId",
          "position",
          "company",
          "text"
        ]
      }
    },
    {
      "id": "programming_languages_simple",
      "title": "Programming Languages Data",
      "file": "data/programming_languages.json",
      "labelField": "name",
      "schema": {
        "title": "Programming Language",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nom du langage"
          },
          "experience": {
            "type": "number",
            "title": "Expérience (en années)",
            "description": "1 = 1 an, 0.5 = 6 mois"
          },
          "iconPath": {
            "type": "string",
            "title": "Chemin vers l'icône SVG",
            "description": "Chemin relatif depuis le dossier static/ (ex: images/technologies/C#.svg)"
          },
          "color": {
            "type": "string",
            "title": "Couleur",
            "widget": "colorPicker"
          },
          "displayedInPortfolio": {
            "type": "boolean",
            "title": "Affiché dans la section portfolio",
            "description": "Ce langage de programmation est-il mis en avant dans le portfolio ?"
          }
        },
        "required": [
          "name",
          "experience",
          "displayedInPortfolio"
        ]
      }
    },
    {
      "id": "frameworks_engines_simple",
      "title": "Frameworks & Engines Data",
      "file": "data/frameworks_engines.json",
      "labelField": "name",
      "schema": {
        "title": "Framework",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nom du framework/moteur"
          },
          "experience": {
            "type": "number",
            "title": "Expérience (en années)",
            "description": "1 = 1 an, 0.5 = 6 mois"
          },
          "iconPath": {
            "type": "string",
            "title": "Chemin vers l'icône SVG",
            "description": "Chemin relatif depuis le dossier static/ (ex: images/technologies/Unity.svg)"
          },
          "color": {
            "type": "string",
            "title": "Couleur",
            "widget": "colorPicker"
          },
          "displayedInPortfolio": {
            "type": "boolean",
            "title": "Affiché dans le portfolio"
          }
        },
        "required": [
          "name",
          "experience",
          "displayedInPortfolio"
        ]
      }
    },
    {
      "id": "specialties",
      "title": "Specialties Data",
      "file": "data/specialties.json",
      "labelField": "name",
      "schema": {
        "title": "Specialty",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nom de la spécialité"
          },
          "icon": {
            "type": "string",
            "title": "Icône emoji",
            "description": "Emoji utilisé si pas d'iconPath défini"
          },
          "iconPath": {
            "type": "string",
            "title": "Chemin vers l'icône SVG",
            "description": "Chemin relatif depuis le dossier static/ (ex: images/technologies/Unity.svg)"
          },
          "displayedInPortfolio": {
            "type": "boolean",
            "title": "Affiché dans le portfolio"
          },
          "experience": {
            "type": "number",
            "title": "Expérience (en années)",
            "description": "1 = 1 an, 0.5 = 6 mois"
          },
          "subtitle": {
            "type": "string",
            "title": "Sous-titre",
            "description": "Texte affiché sous le nom dans le portfolio"
          }
        },
        "required": [
          "name",
          "displayedInPortfolio",
          "subtitle"
        ]
      }
    },
    {
