{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Content preview",
          "name": "preview",
          "type": "image"
        },
        {
          "title": "Is in draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        }
      ]
    },
    {
      "name": "project-content-type",
      "pageBundle": false,
      "fields": [
        {
          "title": "Date de publication",
          "name": "date",
          "type": "datetime"
        },
        {
          "title": "Brouillon",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Titre du projet",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Sous-titre",
          "name": "subtitle",
          "type": "string"
        },
        {
          "title": "Description du projet",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Image principale",
          "name": "image",
          "type": "image"
        },
        {
          "title": "Logo du projet",
          "name": "logo",
          "type": "image"
        },
        {
          "title": "Diaporama d'images",
          "name": "diaporama",
          "type": "list"
        },
        {
          "title": "Étiquettes",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Technologies utilisées",
          "name": "technologies",
          "type": "choice",
          "choices": [
            "C++",
            "Lua",
            "Level Design",
            "3D Modeling",
            "Texturing",
            "FX",
            "Sound Design"
          ]
        },
        {
          "title": "Catégorie",
          "name": "category",
          "type": "categories"
        },
        {
          "title": "Secteur d'activité",
          "name": "sector",
          "type": "string"
        },
        {
          "title": "Projet à la une",
          "name": "featured",
          "type": "boolean"
        },
        {
          "title": "Statut",
          "name": "status",
          "type": "choice",
          "choices": [
            "Prochainement",
            "En Cours",
            "Terminé"
          ]
        },
        {
          "title": "Actions associées",
          "name": "actions",
          "type": "block",
          "fieldGroup": [
            "actions_group"
          ]
        },
        {
          "title": "Faits marquants",
          "name": "notable_facts",
          "type": "block",
          "fieldGroup": [
            "notable_facts_group"
          ]
        }
      ]
    }
  ],
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.pageFolders": [
    {
      "title": "posts",
      "path": "[[workspace]]/content/posts"
    },
    {
      "title": "projects",
      "path": "[[workspace]]/content/projects"
    }
  ],
  "frontMatter.content.draftField": {
    "name": "draft",
    "type": "boolean"
  },
  "frontMatter.data.files": [
    {
      "id": "profile",
      "title": "Profile Data",
      "file": "data/profile.json",
      "schema": {
        "title": "Profile",
        "type": "object",
        "properties": {
          "personal": {
            "type": "object",
            "title": "Informations personnelles",
            "properties": {
              "firstName": {
                "type": "string",
                "title": "Prénom"
              },
              "lastName": {
                "type": "string",
                "title": "Nom"
              },
              "fullName": {
                "type": "string",
                "title": "Nom complet"
              },
              "greeting": {
                "type": "string",
                "title": "Message d'accueil"
              },
              "title": {
                "type": "string",
                "title": "Titre professionnel"
              },
              "subtitle": {
                "type": "string",
                "title": "Sous-titre"
              },
              "bio": {
                "type": "string",
                "title": "Biographie",
                "widget": "textarea"
              }
            }
          },
          "media": {
            "type": "object",
            "title": "Médias",
            "properties": {
              "profileImage": {
                "type": "string",
                "title": "Image de profil"
              },
              "resumeFile": {
                "type": "string",
                "title": "Fichier CV"
              },
              "resumeFilename": {
                "type": "string",
                "title": "Nom du fichier CV"
              }
            }
          },
          "contact": {
            "type": "object",
            "title": "Contact",
            "properties": {
              "email": {
                "type": "string",
                "title": "Email"
              },
              "phone": {
                "type": "string",
                "title": "Téléphone"
              },
              "linkedin": {
                "type": "string",
                "title": "LinkedIn"
              },
              "github": {
                "type": "string",
                "title": "GitHub"
              },
              "location": {
                "type": "string",
                "title": "Localisation"
              },
              "status": {
                "type": "string",
                "title": "Statut"
              }
            }
          },
          "details": {
            "type": "object",
            "title": "Détails",
            "properties": {
              "formation": {
                "type": "string",
                "title": "Formation"
              },
              "speciality": {
                "type": "string",
                "title": "Spécialité"
              },
              "experience": {
                "type": "string",
                "title": "Expérience"
              }
            }
          }
        }
      }
    },
    {
      "id": "experience",
      "title": "Experience Data",
      "file": "data/experiences.json",
      "labelField": "title",
      "schema": {
        "title": "Experience",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "title": "Titre du poste"
            },
            "company": {
              "type": "string",
              "title": "Entreprise"
            },
            "logo": {
              "type": "string",
              "title": "Logo de l'entreprise"
            },
            "period": {
              "type": "string",
              "title": "Période"
            },
            "duration": {
              "type": "string",
              "title": "Durée"
            },
            "type": {
              "type": "string",
              "title": "Type de contrat"
            },
            "location": {
              "type": "string",
              "title": "Localisation"
            },
            "status": {
              "type": "string",
              "title": "Statut",
              "enum": ["current", "completed"]
            },
            "description": {
              "type": "string",
              "title": "Description",
              "widget": "textarea"
            },
            "projects": {
              "type": "array",
              "title": "Projets",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Nom du projet"
                  },
                  "description": {
                    "type": "string",
                    "title": "Description du projet"
                  },
                  "tasks": {
                    "type": "array",
                    "title": "Tâches",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "skills": {
              "type": "array",
              "title": "Compétences",
              "items": {
                "type": "string"
              }
            },
            "technologies": {
              "type": "array",
              "title": "Technologies",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["title", "company", "period", "description"]
        }
    
    },
    {
      "id": "skills",
      "title": "Skills Data",
      "file": "data/skills.json",
      "labelField": "title",
      "schema": {
        "title": "Skills",
        "type": "object",
        "properties": {
          "categories": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "level": {
                        "type": "string"
                      },
                      "experience": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
          },
          "display": {
            "type": "object",
            "title": "Configuration d'affichage",
            "properties": {
              "showLevels": {
                "type": "boolean",
                "title": "Afficher les niveaux"
              },
              "showIcons": {
                "type": "boolean",
                "title": "Afficher les icônes"
              },
              "categoriesPerRow": {
                "type": "number",
                "title": "Catégories par ligne"
              },
              "skillsPerCategory": {
                "type": "number",
                "title": "Compétences par catégorie"
              }
            }
          }
        },
        "required": ["categories"]
      }
    },
    {
      "id": "technologies",
      "title": "Technologies Data",
      "file": "data/technologies.json",
      "labelField": "name",
      "schema": {
        "title": "Technologies",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nom de la technologie"
          },
          "icon": {
            "type": "string",
            "title": "Icône (emoji)"
          },
          "color": {
            "type": "string",
            "title": "Couleur (hex)"
          },
          "enabled": {
            "type": "boolean",
            "title": "Activé dans les filtres"
          },
          "order": {
            "type": "number",
            "title": "Ordre d'affichage"
          },
          "experience": {
            "type": "string",
            "title": "Expérience"
          },
          "level": {
            "type": "string",
            "title": "Niveau"
          }
        },
        "required": [
          "name",
          "icon",
          "enabled",
          "order"
        ]
      }
    },
    {
      "id": "testimonials",
      "title": "Testimonials",
      "file": "data/testimonials.json",
      "labelField": "name",
      "schema": {
        "title": "Testimonials",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nom complet"
          },
          "position": {
            "type": "string",
            "title": "Poste / Rang"
          },
          "company": {
            "type": "string",
            "title": "Entreprise / Organisation"
          },
          "avatar": {
            "type": "string",
            "title": "Avatar (chemin vers l'image)"
          },
          "text": {
            "type": "string",
            "title": "Message de recommandation",
            "widget": "textarea"
          }
        },
        "required": [
          "name",
          "position",
          "company",
          "text"
        ]
      }
    },
    {
      "id": "education",
      "title": "Education Data",
      "file": "data/educations.json",
      "labelField": "title",
      "schema": {
        "title": "Education",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "title": "Titre de la formation"
            },
            "institution": {
              "type": "string",
              "title": "Institution"
            },
            "period": {
              "type": "string",
              "title": "Période"
            },
            "status": {
              "type": "string",
              "title": "Statut"
            },
            "description": {
              "type": "string",
              "title": "Description",
              "widget": "textarea"
            },
            "skills": {
              "type": "array",
              "title": "Compétences acquises",
              "items": {
                "type": "string"
              }
            },
            "grade": {
              "type": "string",
              "title": "Note/Résultat"
            },
            "location": {
              "type": "string",
              "title": "Localisation"
            },
            "icon": {
              "type": "string",
              "title": "Icône"
            },
            "color": {
              "type": "string",
              "title": "Couleur (hex)"
            }
          },
          "required": ["title", "institution", "period", "status", "description"]
        }
    },
    {
      "id": "config",
      "title": "Site Configuration",
      "file": "data/config.json",
      "schema": {
        "title": "Configuration",
        "type": "object",
        "properties": {
          "site": {
            "type": "object",
            "title": "Configuration du site",
            "properties": {
              "title": {
                "type": "string",
                "title": "Titre du site"
              }
            }
          },
          "navigation": {
            "type": "array",
            "title": "Navigation",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "title": "Ancre"
                },
                "label": {
                  "type": "string",
                  "title": "Libellé"
                },
                "icon": {
                  "type": "string",
                  "title": "Icône"
                },
                "active": {
                  "type": "boolean",
                  "title": "Actif"
                }
              },
              "required": ["anchor", "label", "icon"]
            }
          }
        }
      }
    },
    {
      "id": "internships",
      "title": "Internships Data",
      "file": "data/internships.json",
      "labelField": "title",
      "schema": {
        "title": "Internships",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "title": "Titre du stage"
            },
            "company": {
              "type": "string",
              "title": "Entreprise"
            },
            "period": {
              "type": "string",
              "title": "Période"
            },
            "duration": {
              "type": "string",
              "title": "Durée"
            },
            "type": {
              "type": "string",
              "title": "Type de stage"
            },
            "location": {
              "type": "string",
              "title": "Localisation"
            },
            "status": {
              "type": "string",
              "title": "Statut",
              "enum": ["seeking", "confirmed", "completed"]
            },
            "description": {
              "type": "string",
              "title": "Description",
              "widget": "textarea"
            },
            "requirements": {
              "type": "array",
              "title": "Exigences",
              "items": {
                "type": "string"
              }
            },
            "skills": {
              "type": "array",
              "title": "Compétences",
              "items": {
                "type": "string"
              }
            },
            "technologies": {
              "type": "array",
              "title": "Technologies",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["title", "company", "period", "status", "description"]
        }
    },
    {
      "id": "certifications",
      "title": "Certifications Data",
      "file": "data/certifications.json",
      "labelField": "title",
      "schema": {
        "title": "Certifications",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "title": "Titre de la certification"
            },
            "issuer": {
              "type": "string",
              "title": "Organisme émetteur"
            },
            "date": {
              "type": "string",
              "title": "Date"
            },
            "status": {
              "type": "string",
              "title": "Statut",
              "enum": ["En cours", "Obtenu", "Expiré"]
            },
            "description": {
              "type": "string",
              "title": "Description",
              "widget": "textarea"
            },
            "icon": {
              "type": "string",
              "title": "Icône"
            },
            "color": {
              "type": "string",
              "title": "Couleur (hex)"
            }
          },
          "required": ["title", "issuer", "date", "status", "description"]
        }
      }
    
  ],
  "frontMatter.git.enabled": true,
  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "actions_group",
      "fields": [
        {
          "title": "type",
          "name": "type",
          "type": "string"
        },
        {
          "title": "label",
          "name": "label",
          "type": "string"
        },
        {
          "title": "url",
          "name": "url",
          "type": "string"
        },
        {
          "title": "icon",
          "name": "icon",
          "type": "string"
        },
        {
          "title": "primary",
          "name": "primary",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "notable_facts_group",
      "fields": [
        {
          "title": "type",
          "name": "type",
          "type": "string"
        },
        {
          "title": "icon",
          "name": "icon",
          "type": "string"
        },
        {
          "title": "value",
          "name": "value",
          "type": "string"
        },
        {
          "title": "label",
          "name": "label",
          "type": "string"
        }
      ]
    }
  ]
}