    {
      "id": "phases_group",
      "labelField": "name",
      "fields": [
        {
          "title": "name",
          "name": "name",
          "type": "string"
        },
        {
          "title": "duration",
          "name": "duration",
          "type": "string"
        }
      ]
    },
    {
      "id": "gallery_group",
      "labelField": "caption",
      "fields": [
        {
          "title": "url",
          "name": "url",
          "type": "string"
        },
        {
          "title": "caption",
          "name": "caption",
          "type": "string"
        }
      ]
    },
    {
      "id": "galleries_group",
      "labelField": "title",
      "fields": [
        {
          "title": "title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "size",
          "name": "size",
          "type": "choice",
          "choices": [
            "size-small",
            "size-medium",
            "size-large",
            "size-xl"
          ]
        },
        {
          "title": "images",
          "name": "images",
          "type": "block",
          "fieldGroup": [
            "gallery_group"
          ]
        }
      ]
    },
    {
      "id": "youtube_videos_group",
      "labelField": "title",
      "fields": [
        {
          "title": "video_id",
          "name": "video_id",
          "type": "string"
        },
        {
          "title": "title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "duration",
          "name": "duration",
          "type": "string"
        },
        {
          "title": "date",
          "name": "date",
          "type": "string"
        }
      ]
    },
    {
      "id": "youtube_galleries_group",
      "labelField": "title",
      "fields": [
        {
          "title": "title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "size",
          "name": "size",
          "type": "choice",
          "choices": [
            "size-small",
            "size-medium",
            "size-large",
            "size-xl"
          ]
        },
        {
          "title": "videos",
          "name": "videos",
          "type": "block",
          "fieldGroup": [
            "youtube_videos_group"
