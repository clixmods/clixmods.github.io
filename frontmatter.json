{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.draftField": {
    "name": "draft",
    "type": "boolean"
  },
  "frontMatter.git.enabled": true,
  "frontMatter.data.files": [
    {
      "id": "role_contributor",
      "title": "Rôles contributeurs",
      "file": "data/role-contributor.json",
      "fileType": "json",
      "labelField": "name",
      "schema": {
        "title": "Rôle contributeur",
        "type": "object",
        "required": ["name", "category"],
        "properties": {
          "name": {
            "type": "string",
            "title": "Nom du rôle"
          },
          "category": {
            "type": "string",
            "title": "Catégorie",
            "enum": [
              "Management",
              "Development",
              "Design",
              "Art",
              "Animation",
              "Audio",
              "Level Design",
              "Assets",
              "UI/UX",
              "Support",
              "QA",
              "VFX",
              "Tools",
              "Community",
              "Marketing"
            ]
          },
          "icon": {
            "type": "string",
            "title": "Icône (emoji)"
          }
        }
      }
    }
  ]
}